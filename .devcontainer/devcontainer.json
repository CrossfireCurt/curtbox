{
  "name": "Curtbox · Node 22 / PostgreSQL 16",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "runServices": [
    "db",
    "workspace"
  ],
  "workspaceFolder": "/workspaces/curtbox",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "forwardPorts": [
    5173,
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Curtbox server (API + Socket.IO)",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Curtbox (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
