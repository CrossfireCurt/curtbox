# Copy this file to .env; never commit production secrets.
# Generate an Argon2id hash: npm run password-hash -- 'strong-long-admin-password'
# If the hash includes dollar signs, use SINGLE QUOTES in .env:
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=...'
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# URL-safe random password for Docker Compose PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-secret
# Used only for local development outside Docker; Docker overrides this.
DATABASE_URL=postgres://party:party@localhost:5432/party
PORT=3000
# The following are future local AI endpoints; the initial prototype does not invoke them.
OLLAMA_URL=http://localhost:11434
PIPER_URL=http://localhost:10200

# For compose.ghcr.yml only, set the GitHub Container Registry image (lowercase).
# Example: CURTBOX_IMAGE=ghcr.io/your-github-user/curtbox:v0.1.0
# The :main tag updates on every successful main build; :latest updates on stable releases.
# CURTBOX_IMAGE=
